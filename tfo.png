		<style type="text/css" id="wp-custom-css">
			.gform_wrapper.gravity-theme .gform_heading {
    display: none;
}

.hero__slider .hero__slide {
    margin-bottom: -25px;
}

ul.products {
    list-style: none !important;
}

/* CartBounty Popup Body Text Side */
#cartbounty-pro-exit-intent-form p, #cartbounty-pro-push-notification-permission p {
    font-size: 20px;
    line-height: 29px;
    margin: 0;
    padding: 0 0 20px;
}

/* Mobile Hero Slider Font Size */
@media (max-width: 1000px) {
  .hero__title,
  .hero__title * {
    font-size: 2.2rem;
    line-height: 1.0;
  }
	
	
.hero__title strong {
        font-size: 1rem !important;
}
}

.wpfront-notification-bar a.wpfront-button, .wpfront-notification-bar-editor a.wpfront-button {
    display: inline-block;
    box-shadow: none;
    white-space: nowrap;
    font-size: 16px !important;
    font-weight: 700;
    text-align: center;
    text-decoration: none !important;
    text-shadow: 0 !important;
    cursor: pointer;
    padding: 5px 10px;
    margin-left: 5px;
    border-radius: 0px !important;
    -webkit-border-radius: 0px !important;
    -moz-border-radius: 0px !important;
}

#wpfront-notification-bar div.wpfront-close {
    border: 1px solid #ffffff;
    background-color: #ffffff;
    color: #fd5b05 !important;
}

/* stack second-level submenu items vertically */
.mega-menu > .sub-menu > li > .sub-menu {
  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
  gap: 0px !important;
}

/* make each child item take its own row */
.mega-menu > .sub-menu > li > .sub-menu > li {
  display: block !important;
  width: 100% !important;
  margin: 0 !important;
}

/* Pull sub-sub menu closer to "Conventional Fishing" */
  #menu-item-1976 > .sub-menu,
  #menu-item-190742 > .sub-menu,
	#menu-item-4126 > .sub-menu,
  #menu-item-1975 > .sub-menu {
  margin-top: -12px !important;
  padding-top: 0 !important;
}

/* Remove extra spacing under the parent link */
  #menu-item-1976 > .sub-menu,
	#menu-item-190742 > .sub-menu,
	#menu-item-4126 > .sub-menu,
  #menu-item-1975 > .sub-menu {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

/* Parent menu item */
  #menu-item-1976 > .sub-menu,
	#menu-item-190742 > .sub-menu,
	#menu-item-4126 > .sub-menu,
  #menu-item-1975 > .sub-menu {
  margin-bottom: 0 !important;
  padding-bottom: 6px !important;
  display: block !important;
}

/* Nested submenu under Conventional Fishing */
  #menu-item-1976 > .sub-menu,
	#menu-item-190742 > .sub-menu,
	#menu-item-4126 > .sub-menu,
  #menu-item-1975 > .sub-menu {
  margin-top: 0 !important;
  padding-top: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 6px !important;
}

/* Child items */
  #menu-item-1976 > .sub-menu > li,
	#menu-item-190742 > .sub-menu > li,
  #menu-item-4126 > .sub-menu > li,
  #menu-item-1975 > .sub-menu > li {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
}

/* Child links */
  #menu-item-1976 > .sub-menu > li,
	  #menu-item-190742 > .sub-menu > li,
  #menu-item-4126 > .sub-menu > li,
  #menu-item-1975 > .sub-menu > li {
  display: block !important;
  padding: 0 !important;
  line-height: 1.2 !important;
}

/* DESKTOP */
@media (min-width: 981px) {
  #menu-item-1976 > .sub-menu,
	#menu-item-190742 > .sub-menu,
	#menu-item-4126 > .sub-menu,
  #menu-item-1975 > .sub-menu {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }
}

/* MOBILE */
@media (max-width: 980px) {
  #menu-item-1976 > .sub-menu,
	#menu-item-190742 > .sub-menu,
	#menu-item-4126 > .sub-menu,
  #menu-item-1975 > .sub-menu {
    display: block !important;
    position: static !important;
    width: 100% !important;
    margin-top: 8px !important;
  }
}
@media (max-width: 980px) {

  /* Conventional Fishing child links on mobile */
  #menu-item-1976 > .sub-menu > li,
	#menu-item-190742 > .sub-menu > li,
	  #menu-item-4126 > .sub-menu > li,
  #menu-item-1975 > .sub-menu > li {
    font-size: 14px !important;
    font-weight: 400 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    line-height: 1.25 !important;
    padding: 2px 0 !important;
    display: block !important;
  }

  /* In case the theme styles all submenu anchors broadly */
  .has-mega-menu .sub-menu .menu-item #menu-item-1976 > .sub-menu > li > a,
	  .has-mega-menu .sub-menu .menu-item #menu-item-190742 > .sub-menu > li > a,
	  .has-mega-menu .sub-menu .menu-item #menu-item-4126 > .sub-menu > li > a,
  .mega-menu .sub-menu .menu-item #menu-item-1976 > .sub-menu > li > a {
    font-size: 14px !important;
    font-weight: 400 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
  }
}

  /* In case the theme styles all submenu anchors broadly */
  .has-mega-menu .sub-menu .menu-item #menu-item-1975 > .sub-menu > li > a,
  .has-mega-menu .sub-menu .menu-item #menu-item-190742 > .sub-menu > li > a,
  .has-mega-menu .sub-menu .menu-item #menu-item-4126 > .sub-menu > li > a,
  .mega-menu .sub-menu .menu-item #menu-item-1976 > .sub-menu > li > a {
    font-size: 14px !important;
    font-weight: 400 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
  }


  /* Remove Menu Shadows*/
@media screen and (max-width: 1024px) {
  .primaryNav li .sub-menu .sub-menu {
    box-shadow: none !important;
    -webkit-box-shadow: none !important;
  }
}

  /* Submenu Mobile Font Size */
@media screen and (max-width: 1024px) {
    .primaryNav li .sub-menu>li>a {
        color: #141414 !important;
        font-size: 14px;
    }
}


  /* Main Submenu Font Color */
/* Smaller nested submenu links only */
.mega-menu > .sub-menu > li > .sub-menu > li > a {
  color: #444 !important;
}

.mega-menu > .sub-menu > li > .sub-menu > li > a:hover {
  color: #fd5b05 !important;
}

/* Smaller nested submenu links only */
.mega-menu > .sub-menu > li > .sub-menu > li > a {
  color: #444 !important;          /* or use your orange if preferred */
  font-weight: 100 !important;     /* removes bold */
  text-transform: none !important;
}

  /* Margin on ID Anchor Link */
[id] {
  scroll-margin-top: 40px;
}


  /* Hide Blog Menus */
div.post-filter {
    display: none;
}


  /* TFO AI */
.mwai-chatgpt-theme .mwai-reply .mwai-text > *:last-child {
