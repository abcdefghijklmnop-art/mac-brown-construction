.mkdf-title-holder.mkdf-standard-with-breadcrumbs-type .mkdf-page-title{display:none;}
.mkdf-post-info-top{display:none;}
.mkdf-post-image {display:none!important;}
.mkdf-blog-holder article .mkdf-post-title{display:none;}
.mkdf-content .mkdf-content-inner
