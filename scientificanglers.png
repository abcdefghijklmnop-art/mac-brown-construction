<style id='wail-frontend-inline-css' type='text/css'>

		/* Desktop/General: container sits under gallery, full width */
		.wail-attrs { clear: both; width: 100%; margin: 14px 0 0; }

		/* Each attribute row: label left, icons right */
		.wail-attr {
			display: grid;
			grid-template-columns: max(140px, 20%) 1fr;
			align-items: center;
			gap: 8px 16px;
			padding: 8px 0;
			border-top: 1px solid rgba(0,0,0,.06);
		}
		.wail-attr:first-child { border-top: 0; }

		/* Label styling */
		.wail-label {
			font-weight: 600;
			font-size: .95rem;
			line-height: 1.2;
			white-space: nowrap;
		}

		/* Icons column */
		.wail-values {
			display: flex;
			flex-wrap: wrap;
			gap: 8px 12px;
			align-items: center;
		}

		/* Icon visuals (60px max height as you requested) */
		.wail-icon {
			display: inline-block;
			height: auto;
			vertical-align: middle;
			max-height: 75px;
		}

		/* Mobile-only wrapper is hidden by default */
		.wail-attrs-mobile { display: none; }

		/* Mobile breakpoint: hide desktop row, show mobile row below short description */
		@media (max-width: 600px) {
			.wail-attrs { display: none; }
			.wail-attrs-mobile {
				display: block;
				clear: both;
				width: 100%;
				margin: 14px 0 0;
			}
			/* Stack label above icons on small screens */
			.wail-attrs-mobile .wail-attr {
				grid-template-columns: 1fr;
				gap: 4px 0;
			}
			.wail-attrs-mobile .wail-label { margin-bottom: 2px; }
		}
		
/*# sourceURL=wail-frontend-inline-css */
</style>
